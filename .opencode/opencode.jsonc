{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ],
    "default_agent": "plan",
    "agent": {
        "build": {
            "model": "opencode-go/deepseek-v4-flash",
            "permission": {
                "task": {
                    "*": "allow",
                    "review": "deny"
                },
                "websearch": "ask",
                "webfetch": "deny"
            }
        },
        "plan": {
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "high",
            "permission": {
                "write": {
                    "openspec/**/*": "allow",
                    "*": "deny"
                },
                "edit": {
                    "openspec/**/*": "allow",
                    "*":  "deny"
                },
                "task": {
                    "*": "allow",
                    "code": "deny"
                },
                "websearch": "allow",
                "webfetch": "ask"
            }
        },
        "architect": {
            "model": "opencode-go/glm-5.1"
        },
        "ask": {
            "model": "opencode-go/deepseek-v4-flash"
        },
        "code": {
            "model": "opencode-go/minimax-m2.7"
        }
    }
}
